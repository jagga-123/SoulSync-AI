# =============================================================================
# SoulSync AI backend — environment
#
#   cp .env.example .env         # then fill in the blanks
#   npm run check:env            # validates it exactly as the server does at boot
#   NODE_ENV=production npm run check:env   # also applies the production-only guards
#
# Anything left blank is optional and switches that feature off cleanly.
# =============================================================================

# ---- Server -----------------------------------------------------------------
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/soulsync?retryWrites=true&w=majority
MONGODB_URI=

# ---- Auth -------------------------------------------------------------------
# Use a long, random string in production (>= 32 chars is ENFORCED): openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Web origins ------------------------------------------------------------
# The origin of the Next.js frontend (CORS + Socket.IO + links inside emails).
# Must be https:// in production.
CLIENT_URL=http://localhost:3000
# Extra allowed browser origins, comma-separated (e.g. a staging site or a Vercel preview domain).
CLIENT_ORIGINS=
# Public URL of THIS API including /api — enables one-click List-Unsubscribe headers in email.
# Example: https://soulsync-api.onrender.com/api
API_PUBLIC_URL=

# ---- AI interview / personality analysis (Phase 5) ---------------------------
# GROQ_API_KEY set → Groq is the primary provider and Gemini (GEMINI_API_KEY) the automatic
#                    fallback; AI_PROVIDER is then only consulted for "local".
# Otherwise:
#   auto   → use the first provider below that has an API key (claude → openai → gemini)
#   claude | openai | gemini → force one provider (its API key becomes required)
#   local  → never call an external AI; use the built-in analysis engine
# If every provider fails (or none is set) the app uses the built-in engine — it never errors.
AI_PROVIDER=auto
AI_REQUEST_TIMEOUT_MS=30000

# console.groq.com — primary AI provider (Groq is tried first, Gemini is the fallback)
GROQ_API_KEY=
# Groq model used for interview questions, analysis and match explanations
GROQ_MODEL=qwen/qwen3.8-27b

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Route a safety-declined request to Anthropic's recommended fallback model
ANTHROPIC_REFUSAL_FALLBACK=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Optional endpoint overrides (proxies / gateways / local test doubles)
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=
# GEMINI_BASE_URL=
# GROQ_BASE_URL=

# ---- Feature flags (Phase 6) --------------------------------------------------
# Every paid/monetisation feature ships OFF and is switched on WITHOUT a deploy from
# the admin dashboard (/admin/flags). Resolution order: admin dashboard > this variable > default.
# This variable is only for pinning a value from the environment, e.g.
#   FEATURE_FLAGS=billing=true,advanced_filters=true
# Keys: billing, like_limits, unlimited_likes, advanced_filters, priority_recommendations,
#       profile_boost, ai_deep_analysis, read_receipts_insights, referrals, referral_rewards,
#       waitlist_mode, profile_views, notifications, email_notifications, reports, blocking
FEATURE_FLAGS=

# ---- Admin ---------------------------------------------------------------------
# Comma-separated emails that become admins once they VERIFY that address.
# (Or promote directly:  npm run make-admin -- you@example.com)
ADMIN_EMAILS=

# ---- Email (Phase 6) ------------------------------------------------------------
# log      → write emails to the server log instead of sending (development default)
# brevo | resend | sendgrid → send through the API providers, with automatic fallback:
#            Brevo → Resend → SendGrid, each only if its key is set below. The one named
#            here is tried first (use "brevo" for the order above); it needs its own key.
# smtp     → any SMTP server             (needs SMTP_HOST; standalone, no fallback)
EMAIL_PROVIDER=log
# The ONE sender identity every email goes out under — read from here and nowhere else: the code has no
# default and no fallback address. REQUIRED for every provider except "log". It must be a sender/domain you
# have verified with the provider — for Brevo: Senders, Domains & Dedicated IPs → Senders (Domains for SPF/DKIM).
# Format: EMAIL_FROM="SoulSync AI <sender-verified-in-brevo@yourdomain.com>"
EMAIL_FROM=
# Optional Reply-To (a mailbox you read), added to every email.
EMAIL_REPLY_TO=
# brevo.com — primary email provider. Two ways in (npm run check:email tells you which one works):
#   • an API key (xkeysib-…)  → Brevo's REST API                     (Brevo → SMTP & API → API keys)
#   • an SMTP key (xsmtpsib-…) + SMTP_USER (the SMTP login)  → Brevo's SMTP relay (SMTP & API → SMTP tab)
#     with SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587. An SMTP key does NOT work with the REST API.
BREVO_API_KEY=
# Fallback email providers (tried after Brevo)
RESEND_API_KEY=
SENDGRID_API_KEY=
# SMTP: either a standalone provider (EMAIL_PROVIDER=smtp) or Brevo's relay (EMAIL_PROVIDER=brevo + SMTP key).
# SMTP relay only (no provider APIs, no fallbacks) — the simplest Brevo setup:
#   EMAIL_PROVIDER=smtp  SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_SECURE=false
#   SMTP_USER=<the SMTP login from Brevo → SMTP & API → SMTP tab>   SMTP_PASS=<an SMTP key (xsmtpsib-…)>
# The connection is verified at startup (logged, never fatal) and reported by GET /api/email/health.
# Brevo relay via EMAIL_PROVIDER=brevo instead: SMTP_PASS defaults to the SMTP key in BREVO_API_KEY.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional endpoint overrides (test doubles / regional endpoints)
# BREVO_BASE_URL=
# RESEND_BASE_URL=
# SENDGRID_BASE_URL=

# ---- Payments (Phase 6) ------------------------------------------------------------
# none     → checkout unavailable
# mock     → sandbox checkout for development/demos (REFUSED in production)
# stripe   → USD, Stripe Checkout + webhooks
# razorpay → INR, Razorpay Subscriptions + webhooks
# Even with a provider configured, checkout stays closed until the `billing` flag is switched on.
PAYMENT_PROVIDER=none

# Stripe — webhook endpoint:  POST <API>/api/billing/webhook/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
# Test doubles only:
# STRIPE_API_HOST=
# STRIPE_API_PORT=
# STRIPE_API_PROTOCOL=

# Razorpay — webhook endpoint:  POST <API>/api/billing/webhook/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PREMIUM_MONTHLY=
RAZORPAY_PLAN_PREMIUM_YEARLY=
RAZORPAY_PLAN_PLUS_MONTHLY=
RAZORPAY_PLAN_PLUS_YEARLY=
# RAZORPAY_BASE_URL=

# ---- Profile photo storage (Cloudinary-ready) -----------------------------------------
# With the three Cloudinary values below, photos upload straight from the browser to Cloudinary
# (signed by this API) and old ones are deleted from Cloudinary when replaced or removed.
# Without them, LOCAL_UPLOADS (below) is the free fallback.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=soulsync/profiles

# Free fallback when Cloudinary isn't configured: photos (JPG/PNG/WebP, max 5 MB) are validated,
# re-encoded to WebP with EXIF/GPS stripped, given a 256px thumbnail, and stored on this server's disk.
#   auto → on in development, off in production (most hosts wipe the disk on every deploy)
#   on / off → force it
LOCAL_UPLOADS=auto
# Where local photos are stored (default: backend/uploads). Point it at a persistent volume if you use LOCAL_UPLOADS=on in production.
# UPLOAD_DIR=

# ---- Production hardening (Phase 6) ------------------------------------------------------
# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# How many reverse proxies sit in front of the API. Render / Railway = 1.
# Wrong values make rate limits and logs see the proxy's IP instead of the client's.
TRUST_PROXY=0

# Rate limits (per IP for auth/global; per user on abuse-prone actions). Never disable in production.
RATE_LIMIT_DISABLED=false
RATE_LIMIT_GLOBAL_MAX=1000
RATE_LIMIT_AUTH_MAX=30

# Protects GET /api/metrics (Prometheus). >= 16 chars. Unset = endpoint disabled in production.
METRICS_TOKEN=

# Error tracking (optional). Sentry is loaded only when this is set; PII is stripped before send.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Scheduled jobs (subscription expiry, weekly report).
#   JOBS_ENABLED=true  → run in-process, guarded by a database lock (safe with several instances)
#   JOBS_ENABLED=false → trigger from an external cron:  POST /api/internal/jobs/<name>  with
#                        header  x-cron-secret: <CRON_SECRET>  (jobs: subscription-expiry, weekly-report)
JOBS_ENABLED=true
CRON_SECRET=
