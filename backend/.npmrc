# TypeScript (and the @types/* packages) are devDependencies, but the server has to be COMPILED on the host.
# Render and most other hosts set NODE_ENV=production, which makes `npm install` / `npm ci` skip devDependencies,
# and the build then fails with "tsc: not found". Always installing them makes the build independent of that setting
# and of the Build Command configured in the dashboard. The running server never calls `npm install`, so nothing
# else changes.
include=dev
