{
  "name": "soulsync-backend",
  "version": "1.0.0",
  "private": true,
  "description": "SoulSync AI backend â€” REST + Socket.IO API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "check:env": "tsx scripts/check-env.ts",
    "make-admin": "tsx scripts/make-admin.ts",
    "test": "tsx --test --test-reporter=spec --test-concurrency=2 \"tests/**/*.test.ts\"",
    "test:unit": "tsx --test --test-reporter=spec --test-concurrency=4 \"tests/unit/**/*.test.ts\"",
    "test:integration": "tsx --test --test-reporter=spec --test-concurrency=2 \"tests/integration/**/*.test.ts\"",
    "check:ai": "tsx scripts/check-ai.ts",
    "check:email": "tsx scripts/check-email.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@google/genai": "^2.23.0",
    "@sentry/node": "^10.75.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "nodemailer": "^10.0.10",
    "openai": "^7.18.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "stripe": "^22.6.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "mongodb-memory-server": "^11.2.0",
    "smtp-server": "^3.19.13",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
