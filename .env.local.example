# Base URL of the SoulSync AI backend API (see backend/.env.example)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Optional: only if the Socket.IO server is NOT on the same origin as the API above
# (by default it is derived from NEXT_PUBLIC_API_URL by dropping the trailing /api).
# NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Public origin of the site (canonical URLs, Open Graph, sitemap). Optional on Vercel — the production
# deployment address is used automatically — but set it as soon as you have a real domain.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
